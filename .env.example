# Local list bridge. Copy to .env and fill in values; never commit .env.
LIST_BRIDGE_SECRET=
TZ=Europe/London
LIST_BRIDGE_CACHE_SECONDS=3600
# Host directory containing trakt.json from your existing browser login.
TRAKT_TOKEN_DIR=${HOME}/.plextraktsync-secrets
BRIDGE_BIND_ADDRESS=127.0.0.1
BRIDGE_PORT=8090
# Optional: either TMDB v3 API key OR API Read Access Token. Token takes precedence.
TMDB_API_KEY=
TMDB_READ_ACCESS_TOKEN=
# Optional direct adds: addresses reachable from inside Docker, not localhost.
RADARR_URL=
RADARR_API_KEY=
SONARR_URL=
SONARR_API_KEY=
# Used by the all-in-one supervisor, not the bridge-only test service.
SLACK_WEBHOOK_URL=

# Optional PKCE sign-in: register the exact redirect with your Trakt app.
TRAKT_PKCE_CLIENT_ID=
TRAKT_PKCE_REDIRECT_URI=
TRAKT_PKCE_ALLOW_LOCAL_HTTP=false
# Optional WireGuard transport: requires the gateway service; disabled by default.
TRAKT_VPN_ENABLED=false
TRAKT_VPN_PROXY_URL=http://trakt-vpn:8080
TRAKT_VPN_CONTROL_URL=http://trakt-vpn:9090
WIREGUARD_CONFIG_PATH=
WIREGUARD_CONFIG_DIR=
